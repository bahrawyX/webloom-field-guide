  "fields": {
    "title": "Flexbox",
    "textContent": {
      "nodeType": "document",
      "data": {},
      "content": [
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Description",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Flexbox",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " is used to create variable and responsive layouts in CSS. This model acts on two axes on which content can be arranged. Another similar concept is ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "entry-hyperlink",
              "data": {
                "target": {
                  "sys": {
                    "id": "4WSOOanCzUHy0akMtqzc5k",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "nodeType": "text",
                  "value": "grid",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "text",
              "value": ", which can be also styled in ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "entry-hyperlink",
              "data": {
                "target": {
                  "sys": {
                    "id": "3TBGoqMl1snjRBxLIzrc6Z",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "nodeType": "text",
                  "value": "CSS",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "text",
              "value": ". ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "Flexbox ",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "can be understood similarly to the columns in Adobe InDesign. The width and height of these columns are also aligned with the format of the document. In contrast to InDesign, there are several options for aligning and arranging elements in columns and rows with ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "flexbox",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": ". This way it's quite easy to make ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "entry-hyperlink",
              "data": {
                "target": {
                  "sys": {
                    "id": "2ABYnMzPbdcoVRHCQpEav8",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "nodeType": "text",
                  "value": "responsive",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "text",
              "value": " layouts with ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "flexbox",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " and ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "entry-hyperlink",
              "data": {
                "target": {
                  "sys": {
                    "id": "6Nc9jvBRCAEoyS4EDF9O6E",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "nodeType": "text",
                  "value": "media queries",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "text",
              "value": ". The most ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "flexbox",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " properties are set on the container element and describe how the items inside this container will be aligned.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "35NWzt0WvOtmoeSXlKQRN",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Visualisation",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Here comes a short visualisation of the most important ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "flexbox",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " properties: ",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "heading-5",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "flex-direction",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Setting the main axis, as well as the direction in which the flex items are placed in the flex container, is done with this property.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "4SJq15C3oiN6jGONQcCBKi",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "heading-5",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "flex-wrap",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "By default, the flex items try to fit all in one row. This can be changed by wrapping items. ",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "6IxUueNapSJuNIyO9aNzhM",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "heading-5",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "justify-content",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "This property defines how the browser distributes space between and around content items along the main axis of a flex container and the inline axis of a grid container.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "5yeCs5L3VGfqDFaoc6zYUD",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "heading-5",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "align-items",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "This property sets the value for all direct child elements as a group. It controls the alignment of elements on the cross axis. In grid layout, it controls the alignment of elements on the block axis within their grid area.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "4mPXklp9cSJf85Xp6cp6RD",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "heading-5",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "align-content",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "The rows of a flex container can be oriented differently if additional space is available in the cross-axis.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "FdTHKQjxk7vFBI9Noqbpq",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "heading-5",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "gap, row-gap, column-gap",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "The property sets the spacing between rows and columns.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
              "sys": {
                "id": "2WGKTmG4E9x9vgAES8DxsK",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": []
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
