        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "The text-align property sets the horizontal alignment of text content inside a block element or table-cell box. This is similar to the text-alignment that you can do in layout programs like InDesign or Illustrator. The default value for text alignment is left.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Here are visualisations of the different text-align values:",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
