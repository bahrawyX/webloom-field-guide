  "fields": {
    "title": "Heading",
    "textContent": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Description",
              "nodeType": "text"
            }
          ],
          "nodeType": "heading-3"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "In ",
              "nodeType": "text"
            },
            {
              "data": {
                "target": {
                  "sys": {
                    "id": "5E1SmovXET5h0cV1E0tOzT",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "data": {},
                  "marks": [],
                  "value": "HTML",
                  "nodeType": "text"
                }
              ],
              "nodeType": "entry-hyperlink"
            },
            {
              "data": {},
              "marks": [],
              "value": " headings are defined with the <h1> to <h6> tags, which represent ",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [],
              "value": "six levels of section headings",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [],
              "value": ". <h1> defines the most important heading. <h6> defines the least important heading.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Having a correct heading structure implemented on your website is important to make it ",
              "nodeType": "text"
            },
            {
              "data": {
                "target": {
                  "sys": {
                    "id": "4TzAZFehkMPRfclxZU7jhz",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "data": {},
                  "marks": [],
                  "value": "accessible",
                  "nodeType": "text"
                }
              ],
              "nodeType": "entry-hyperlink"
            },
            {
              "data": {},
              "marks": [],
              "value": ". A common navigation technique for users of screen reading software is to quickly jump from heading to heading in order to determine the content of the page. Because of this, it is important to not skip one or more heading levels. Doing so may create confusion, as the person navigating this way may be left wondering where the missing heading is.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Usage",
              "nodeType": "text"
            }
          ],
          "nodeType": "heading-3"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "Heading information can be used by user agents to construct a table of contents for a document automatically",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "Do not use heading elements to resize text. Instead, use the CSS font-size property",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "H",
                      "nodeType": "text"
                    },
                    {
                      "data": {},
                      "marks": [],
                      "value": "eadings come with a default css styling, like margin, which you can manually overwrite ",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "Use only one <h1> per page and nest headings without skipping levels: always start from <h1>, followed by <h2> and so on",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "Browsers automatically add some white space (a ",
                      "nodeType": "text"
                    },
                    {
                      "data": {
                        "target": {
                          "sys": {
                            "id": "AbOSsxIGAkVSMh1dhVbK4",
                            "type": "Link",
                            "linkType": "Entry"
                          }
                        }
                      },
                      "content": [
                        {
                          "data": {},
                          "marks": [],
                          "value": "margin",
                          "nodeType": "text"
                        }
                      ],
                      "nodeType": "entry-hyperlink"
                    },
                    {
                      "data": {},
                      "marks": [],
                      "value": ") before and after a heading",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            }
          ],
          "nodeType": "unordered-list"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
    },
    "codeField": {
