          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "html\n<h1>Level 1</h1>\n\n/* Section 1 */\n<h2>Level 2.1</h2>\n<h3>Level 3.1</h3>\n<h3>Level 3.2</h3>\n\n/* Section 2 */\n<h2>Level 2.2</h2>\n<h3>Level 3.1</h3>\n<h3>Level 3.2</h3>\n\n/* Section 3 */\n<h2>Level 2.3</h2>\n<h3>Level 3.1</h3>\n<h3>Level 3.2</h3>",
              "marks": [
