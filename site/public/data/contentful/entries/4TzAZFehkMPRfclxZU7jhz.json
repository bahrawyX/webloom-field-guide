              "marks": [],
              "value": "Tools",
              "nodeType": "text"
            }
          ],
          "nodeType": "heading-3"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "",
                      "nodeType": "text"
                    },
                    {
                      "data": {
                        "uri": "https://www.webaccessibilitychecklist.com/"
                      },
                      "content": [
                        {
                          "data": {},
                          "marks": [],
                          "value": "Web Accessibility Checklist",
                          "nodeType": "text"
                        }
                      ],
                      "nodeType": "hyperlink"
                    },
                    {
                      "data": {},
                      "marks": [],
                      "value": "",
                      "nodeType": "text"
                    }
                  ],
                  "nodeType": "paragraph"
                }
              ],
              "nodeType": "list-item"
            },
            {
              "data": {},
              "content": [
                {
                  "data": {},
                  "content": [
                    {
                      "data": {},
                      "marks": [],
                      "value": "",
                      "nodeType": "text"
