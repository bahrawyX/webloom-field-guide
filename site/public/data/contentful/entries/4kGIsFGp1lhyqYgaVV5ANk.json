              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [],
              "value": " element. If you want to have different styling inside a paragraph, you can use the ",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "value": "<span>",
