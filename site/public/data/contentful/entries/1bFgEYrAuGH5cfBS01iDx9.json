  "fields": {
    "title": "Text Selection Color",
    "textContent": {
      "nodeType": "document",
      "data": {},
      "content": [
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Description",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "The CSS ::selection selector allows you to override your browser-level or system-level text highlight color with a color of your choosing. You can set it globally (as in the example on the right) or specifically to an element, a class or an id. ",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Note that only a few CSS properties can be applied to this selector: ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "color, background, cursor, text-shadow, text-decoration",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " and ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "outline",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": ". The code on the right shows the styling of this website.",
              "marks": [],
              "data": {}
            }
          ]
        }
      ]
    },
    "codeField": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [
                {
                  "type": "code"
                }
              ],
              "value": "css\n/* for Safari, Chrome etc. Browsers */\n::selection{\n  background:#000000;\n  color:#ffffff;\n}\n/* for Firefox Browsers */\n::-moz-selection{\n  background:#000000;\n  color:#ffffff;\n}",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
