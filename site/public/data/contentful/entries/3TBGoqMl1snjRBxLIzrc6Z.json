              "data": {},
              "marks": [
                {
                  "type": "code"
                }
              ],
              "value": "css\nh1 {\n  font-size: 24px;\n  font-weight: bold;\n  border: 1px solid black;\n  color: pink;\n}\n\n.link {\n  font-size: 12px;\n}",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
    },
