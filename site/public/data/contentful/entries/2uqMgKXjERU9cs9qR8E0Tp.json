  "fields": {
    "title": "Font Smoothing",
    "textContent": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Description",
              "nodeType": "text"
            }
          ],
          "nodeType": "heading-3"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "The ",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "value": "font-smooth",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [],
              "value": " CSS property controls the application of anti-aliasing when fonts are rendered. This rendering is responsible for how type is displayed. Especially on Mac screens, small type without font-smooth is displayed slightly heavier in weight than the font style actually is. This becomes clear, for example, when you compare a website design in Figma with the coded website and wonder, why the typography looks slightly different, even though the same font and weight is used.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "This feature is non-standard, so it's not supported by every browser and device, therefore not everybody will see it. There are also a lot of people not recommending to use font-smoothing, because of ",
              "nodeType": "text"
            },
            {
              "data": {
                "target": {
                  "sys": {
                    "id": "4TzAZFehkMPRfclxZU7jhz",
                    "type": "Link",
                    "linkType": "Entry"
                  }
                }
              },
              "content": [
                {
                  "data": {},
                  "marks": [],
                  "value": "accessibility",
                  "nodeType": "text"
                }
              ],
              "nodeType": "entry-hyperlink"
            },
            {
              "data": {},
              "marks": [],
              "value": " issues.",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {
            "target": {
              "sys": {
                "id": "2tzx5ejkyDOCsvWT5DKzkC",
                "type": "Link",
                "linkType": "Asset"
              }
            }
          },
          "content": [],
          "nodeType": "embedded-asset-block"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "[Top: without font-smoothing, Bottom: with font-smoothing]",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "Example",
              "nodeType": "text"
            }
          ],
          "nodeType": "heading-3"
        },
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [],
              "value": "We use ",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "value": "font-smoothing: antialiased",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [],
              "value": " like in the implementation example on this website. You can toggle the following button to see what it would look like without ",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "value": "font-smoothing",
              "nodeType": "text"
            },
            {
              "data": {},
              "marks": [],
              "value": ".",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
    },
    "codeField": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [
                {
                  "type": "code"
                }
              ],
              "value": "css\nbody {\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
