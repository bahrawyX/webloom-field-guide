  "fields": {
    "title": "Blend-Mode",
    "textContent": {
      "nodeType": "document",
      "data": {},
      "content": [
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Description",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "The ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "mix-blend-mode",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "property describes how an element's content should blend with the content of the element's parent and the element's background. ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "Similar to the blend-modes in photoshop or inDesign you can choose between normal, difference, multiply and many other blend-modes. ",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Be aware, that most mobile browsers currently sadly don't support this feature. Make sure to have a fallback for this scenario, so your website stays accessible.",
              "marks": [],
              "data": {}
            }
          ]
        }
      ]
    },
    "codeField": {
      "data": {},
      "content": [
        {
          "data": {},
          "content": [
            {
              "data": {},
              "marks": [
                {
                  "type": "code"
                }
              ],
              "value": "css\n.blend {\n  mix-blend-mode: difference;\n  /*other possible blend-modes */\n  mix-blend-mode: normal;\n  mix-blend-mode: multiply;\n  mix-blend-mode: screen;\n  mix-blend-mode: overlay;\n  mix-blend-mode: darken;\n  mix-blend-mode: lighten;\n  mix-blend-mode: color-dodge;\n  mix-blend-mode: color-burn;\n  mix-blend-mode: hard-light;\n  mix-blend-mode: soft-light;\n  mix-blend-mode: difference;\n  mix-blend-mode: exclusion;\n  mix-blend-mode: hue;\n  mix-blend-mode: saturation;\n  mix-blend-mode: color;\n  mix-blend-mode: luminosity;\n}",
              "nodeType": "text"
            }
          ],
          "nodeType": "paragraph"
        }
      ],
      "nodeType": "document"
    },
