                      },
                      "content": [
                        {
                          "nodeType": "text",
                          "value": "Creative Coding",
                          "marks": [],
                          "data": {}
                        }
                      ]
                    },
                    {
                      "nodeType": "text",
                      "value": ": If you want to play around with coded animations in general (which not necessary need to be part of a website), then take a loot at the nice creative coding frameworks , that are listed under ",
                      "marks": [],
                      "data": {}
                    },
                    {
                      "nodeType": "entry-hyperlink",
                      "data": {
                        "target": {
                          "sys": {
                            "id": "4iytqKejnODgBvnTYyfKCE",
                            "type": "Link",
                            "linkType": "Entry"
                          }
