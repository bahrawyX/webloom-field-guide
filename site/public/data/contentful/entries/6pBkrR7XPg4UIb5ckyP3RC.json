            {
              "nodeType": "list-item",
              "data": {},
              "content": [
                {
                  "nodeType": "paragraph",
                  "data": {},
                  "content": [
                    {
                      "nodeType": "text",
                      "value": "Interactive Infographics: ",
                      "marks": [],
                      "data": {}
                    },
                    {
                      "nodeType": "hyperlink",
                      "data": {
                        "uri": "https://d3js.org/"
                      },
                      "content": [
                        {
                          "nodeType": "text",
                          "value": "D3.js",
                          "marks": [],
                          "data": {}
                        }
                      ]
                    },
                    {
                      "nodeType": "text",
                      "value": " is a JavaScript library for producing dynamic, interactive data visualisations on websites, using SVG, HTML, and CSS.",
                      "marks": [],
                      "data": {}
                    }
