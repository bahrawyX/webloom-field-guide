  "fields": {
    "title": "Handmade Web",
    "textContent": {
      "nodeType": "document",
      "data": {},
      "content": [
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Description",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Handmade web describes websites, that are handwritten and were produced without the help of professional tools, such as frameworks or templates, and are independent of large platforms like Google, Meta or Amazon.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "blockquote",
          "data": {},
          "content": [
            {
              "nodeType": "paragraph",
              "data": {},
              "content": [
                {
                  "nodeType": "text",
                  "value": "»I evoke the term handmade web to refer to web pages coded by hand rather than by software; web pages made and maintained by individuals rather than by businesses or corporations; web pages which are provisional, temporary, or one-of-a-kind; web pages which challenge conventions of reading, writing, design, ownership, privacy, security, or identity.« ",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ],
                  "data": {}
                },
                {
                  "nodeType": "entry-hyperlink",
                  "data": {
                    "target": {
                      "sys": {
                        "id": "JSsgicJlVnpA01pKw3x6c",
                        "type": "Link",
                        "linkType": "Entry"
                      }
                    }
                  },
                  "content": [
                    {
                      "nodeType": "text",
                      "value": "[1]",
                      "marks": [
                        {
                          "type": "superscript"
                        }
                      ],
                      "data": {}
                    }
                  ]
                },
                {
                  "nodeType": "text",
                  "value": "",
                  "marks": [],
                  "data": {}
                }
              ]
            }
          ]
        },
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Background",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "The term was coined by British-Canadian artist and researcher J.R. Carpenter, refering to websites of the mid-to-late-1990s. The handmade web emerged at a time when print and digital enjoyed a more symbiotic relationship. In his text Carpenter advocates for an ongoing active engagement with the making of web pages and web policies. For him, handmade websites are a form of resistance against the increasing commercialisation of the web. J.R. Carpenter is not only inspired by the web amateurs of the 1990s, but also takes up the approaches of the do-it-yourself movement of the 1960s and 1970s, which advocated self-empowerment, self-organisation, initiative and distrust of established authorities.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "\n\n\n",
              "marks": [],
              "data": {}
            }
          ]
        }
      ]
    },
