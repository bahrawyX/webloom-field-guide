                  "type": "code"
                }
              ],
              "value": "html\n<!-- button with text -->\n<button type=\"button\">\n  Click me\n</button>\n<!-- button with icon and text-->\n<button type=\"button\">\n  <svg aria-hidden=\"true\" viewBox=\"0 0 10 10\">\n    <path d=\"M7 9L5 8 3 9V6L1 4h3l1-3 1 3h3L7 6z\" />\n  </svg>\n  Click me\n</button>",
              "nodeType": "text"
            }
          ],
