  "fields": {
    "title": "Button",
    "textContent": {
      "nodeType": "document",
      "data": {},
      "content": [
        {
          "nodeType": "heading-3",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Description",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "The button tag defines a clickable interactive button. Inside a button element you can put text, but also images or icons (except inside an input button). The interaction of a button is typically added using javascript code.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "You should always specify the type attribute for a button element, to tell browsers what type of button it is. The type attribute can be ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "button, reset",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " or ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "input. ",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "paragraph",
          "data": {},
          "content": [
            {
              "nodeType": "text",
              "value": "Not only the button, but also its different states, like ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "hover, active",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": " or ",
              "marks": [],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": "clicked",
              "marks": [
                {
                  "type": "italic"
                }
              ],
              "data": {}
            },
            {
              "nodeType": "text",
              "value": ", can be styled with CSS.",
              "marks": [],
              "data": {}
            }
          ]
        },
        {
          "nodeType": "embedded-asset-block",
          "data": {
            "target": {
