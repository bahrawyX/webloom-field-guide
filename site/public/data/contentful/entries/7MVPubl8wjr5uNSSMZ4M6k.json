              },
              "content": [
                {
                  "nodeType": "text",
                  "value": "digital literature",
                  "marks": [],
                  "data": {}
                }
              ]
            },
            {
              "nodeType": "text",
              "value": ".",
              "marks": [],
              "data": {}
            }
          ]
        }
      ]
    },
